# Copy to /etc/nvnmchain-explorer.env and adjust. All variables are optional;
# defaults are compiled in / taken from the systemd unit.

# JSON-RPC endpoint (legacy TEMPO_RPC is also accepted)
NVNM_RPC=https://rpc.nvnm.canary.mantrachain.dev
# Sent as x-api-key on JSON-RPC requests, to get past the endpoint's rate limits
# NVNM_RPC_API_KEY=

# WebSocket endpoint for newHeads (polling takes over automatically if unreachable)
WS_URL=wss://ws.nvnm.canary.mantrachain.dev
INDEX_WS=1

# Listen address / port
HOST=0.0.0.0
PORT=8080

# Database location (must be writable by the nvnmchain user)
DB_PATH=/var/lib/nvnmchain-explorer/explorer.db

# Indexer tuning for a sub-second chain
INDEX_POLL_SECONDS=1
INDEX_BATCH=5
INDEX_CONCURRENCY=32
STATS_INTERVAL_SECONDS=5

# Log verbosity (info, debug, warn, error)
RUST_LOG=nvnmchain_explorer=info
