# Local development only: copy to `.env` and adjust. `cargo run` loads it from
# the working directory; variables already set in the environment win.
# Deployments set real environment variables instead (see
# deploy/nvnmchain-explorer.env.example). Every variable is optional.

# Which parts of the explorer this process runs: ALL (default), INDEXER or WEB.
# Informational for now: it is logged at startup and changes nothing else.
ROLE=ALL

# JSON-RPC endpoint (legacy TEMPO_RPC is also accepted)
NVNM_RPC=https://rpc.nvnm.canary.mantrachain.dev
# Sent as x-api-key on JSON-RPC requests, to get past the endpoint's rate limits
# NVNM_RPC_API_KEY=

# WebSocket endpoint for newHeads; INDEX_WS=0 disables it (pure polling)
WS_URL=wss://rpc.nvnm.canary.mantrachain.dev
INDEX_WS=1

# Listen address / port
HOST=127.0.0.1
PORT=8080

# SQLite database path
DB_PATH=explorer.db

# Log verbosity
RUST_LOG=nvnmchain_explorer=info
