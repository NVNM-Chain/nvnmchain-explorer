# Local development settings. Copy to .env (git-ignored) and adjust.
#
# The explorer reads .env at startup; ENV_FILE names another file, and an
# empty ENV_FILE reads none. A variable already set in the environment wins
# over the file. `$NAME` and `${NAME}` in a value are expanded as a shell
# would, so single-quote a value holding a `$`: PGPASSWORD='s3cr$t'.
# Every variable is optional; the comments give the value an unset one takes.

# --- Chain -----------------------------------------------------------------

# JSON-RPC endpoint. Unset: https://rpc.nvnm.canary.mantrachain.dev
# The legacy TEMPO_RPC counts only while NVNM_RPC is unset, here included.
NVNM_RPC=http://localhost:8545
# WebSocket endpoint for newHeads. Unset: wss://ws.nvnm.canary.mantrachain.dev
WS_URL=ws://localhost:8546
# 1 follows the WebSocket feed; unset or 0 polls only.
INDEX_WS=1
# Symbol shown for native gas and burnt amounts. Unset: NVNM
NATIVE_SYMBOL=NVNM

# --- HTTP ------------------------------------------------------------------

# Unset: 0.0.0.0 and 8080
HOST=127.0.0.1
PORT=8080

# --- Database --------------------------------------------------------------

# Postgres, as `docker compose up -d --wait` starts it. DATABASE_URL wins over
# DB_PATH, this file's included: for SQLite, comment it out here, or set
# DATABASE_URL= (empty) in the shell, which this file then leaves alone. The
# URL carries no credentials: PGUSER and PGPASSWORD supply them, so a
# deployment can inject the password on its own, from a secret. The
# connection is plaintext.
DATABASE_URL=postgres://localhost:5432/explorer
PGUSER=explorer
PGPASSWORD=explorer

# SQLite file, used when DATABASE_URL is unset. Unset: explorer.db
DB_PATH=explorer.db
# SQLite page cache, in KiB. Unset: 524288
DB_CACHE_KIB=524288

# all runs web and indexer in one process; web and indexer split them and
# need Postgres. Unset: all
ROLE=all
# The database user web replicas connect as; the indexer grants it read and
# cache-write access, and warns if it does not exist. Unset: explorer_web
DB_WEB_ROLE=explorer_web
# How often a ROLE=web replica polls for new blocks, in ms. Unset: 500
FOLLOW_POLL_MS=500

# --- Indexer and pages -----------------------------------------------------

# Poll interval when the WebSocket feed is unavailable, in s. Unset: 1
INDEX_POLL_SECONDS=1
# Blocks indexed per cycle, forward and backfill each. Unset: 32
INDEX_BATCH=32
# Blocks fetched in parallel. Unset: 32
INDEX_CONCURRENCY=32
# How often the home-page stats are recomputed, in s. Unset: 5
STATS_INTERVAL_SECONDS=5
# Rows in the home page's recent blocks and transactions. Unset: 15 each
RECENT_BLOCK_COUNT=15
RECENT_TX_COUNT=15
# Signature directory for selectors no built-in ABI declares. Unset: OpenChain.
# Set it empty to never ask a third party.
# SIGNATURE_LOOKUP_URL=

# Unset: nvnmchain_explorer=info
RUST_LOG=nvnmchain_explorer=info
